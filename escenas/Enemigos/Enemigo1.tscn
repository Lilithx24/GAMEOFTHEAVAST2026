[node name="Enemigo1" type="Node2D" unique_id=961859499]
editor_description = "Marioneta del enemigo 1. Origen a la altura del suelo. Escala y coloca esta escena desde su nodo raíz. Las piezas se giran desde sus nodos de articulación."

